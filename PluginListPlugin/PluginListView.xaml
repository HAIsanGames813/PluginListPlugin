<UserControl x:Class="PluginList.PluginListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PluginList"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820"
             d:DataContext="{d:DesignInstance local:PluginListViewModel}">

    <UserControl.Resources>
        <!-- ラジオボタン用スタイル（コンパクト） -->
        <Style x:Key="SortRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 切替ToggleButton テンプレート -->
        <ControlTemplate x:Key="IconToggleTemplate" TargetType="ToggleButton">
            <Grid Background="Transparent">
                <Path x:Name="IconPath"
                      Data="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                      Stretch="Uniform" Width="15" Height="15" Opacity="0.45"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="IconPath" Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="IconPath" Property="Opacity" Value="1.0"/>
                    <Setter TargetName="IconPath" Property="Fill" Value="#00AEEF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 削除ToggleButton テンプレート -->
        <ControlTemplate x:Key="DeleteToggleTemplate" TargetType="ToggleButton">
            <Grid Background="Transparent">
                <Path x:Name="IconPath"
                      Data="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                      Stretch="Uniform" Width="15" Height="15" Opacity="0.45"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="IconPath" Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="IconPath" Property="Opacity" Value="1.0"/>
                    <Setter TargetName="IconPath" Property="Fill" Value="#FF4444"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 列幅の共有サイズグループを使うため SharedSizeGroup を利用 -->
        <!-- 列幅を定数として Resources に定義してコードビハインドなしで共有する -->
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 検索 -->
            <RowDefinition Height="Auto"/>
            <!-- ソート種別ラジオ -->
            <RowDefinition Height="Auto"/>
            <!-- 昇順/降順 + 操作ボタン -->
            <RowDefinition Height="*"/>
            <!-- ヘッダー＋リスト (ScrollViewer) -->
            <RowDefinition Height="Auto"/>
            <!-- 変更を適用 -->
        </Grid.RowDefinitions>

        <!-- ===== 検索バー ===== -->
        <TextBox Grid.Row="0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Height="26" VerticalContentAlignment="Center"
                 Margin="0,0,0,8"/>

        <!-- ===== ソート種別ラジオボタン ===== -->
        <Border Grid.Row="1" Padding="8,5" Margin="0,0,0,4"
                BorderBrush="#40808080" BorderThickness="1" CornerRadius="3">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="並び替え：" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
                <RadioButton Style="{StaticResource SortRadio}" Content="名前"
                             IsChecked="{Binding SortType, Converter={x:Static local:StringEqualConverter.Instance}, ConverterParameter=Name, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SortRadio}" Content="作者"
                             IsChecked="{Binding SortType, Converter={x:Static local:StringEqualConverter.Instance}, ConverterParameter=Author, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SortRadio}" Content="バージョン"
                             IsChecked="{Binding SortType, Converter={x:Static local:StringEqualConverter.Instance}, ConverterParameter=Version, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SortRadio}" Content="タイプ"
                             IsChecked="{Binding SortType, Converter={x:Static local:StringEqualConverter.Instance}, ConverterParameter=Type, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SortRadio}" Content="状態"
                             IsChecked="{Binding SortType, Converter={x:Static local:StringEqualConverter.Instance}, ConverterParameter=Status, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SortRadio}" Content="公開日"
                             IsChecked="{Binding SortType, Converter={x:Static local:StringEqualConverter.Instance}, ConverterParameter=PublishedAt, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource SortRadio}" Content="DL日時"
                             IsChecked="{Binding SortType, Converter={x:Static local:StringEqualConverter.Instance}, ConverterParameter=DownloadedAt, Mode=TwoWay}"/>
            </WrapPanel>
        </Border>

        <!-- ===== 昇順/降順 + 操作ボタン ===== -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="8,4"
                    BorderBrush="#40808080" BorderThickness="1" CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SortRadio}" Content="昇順"
                                 IsChecked="{Binding IsAscending, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource SortRadio}" Content="降順" Margin="0"
                                 IsChecked="{Binding IsAscending, Converter={x:Static local:BoolInvertConverter.Instance}, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="有効化"  Command="{Binding BulkEnableCommand}"  Margin="0,0,5,0" Padding="8,2"/>
                <Button Content="無効化"  Command="{Binding BulkDisableCommand}" Margin="0,0,5,0" Padding="8,2"/>
                <Button Content="削除"    Command="{Binding BulkDeleteCommand}"  Margin="0,0,5,0" Padding="8,2"/>
                <Button Command="{Binding OpenPluginFolderCommand}" Padding="6,2" ToolTip="プラグインフォルダを開く">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" Width="14" Height="14" Margin="0,0,4,0"/>
                        <TextBlock Text="フォルダ" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== ヘッダー ＋ リスト (横スクロール同期) ===== -->
        <!--
            ScrollViewer で全体を包み、ヘッダーと ListBox を同じ ScrollViewer 内の Grid に置く。
            ListBox 自身のスクロールを無効にして ScrollViewer に委ねることで
            ヘッダーとアイテム行が常に同期してスクロールする。
        -->
        <ScrollViewer x:Name="OuterScrollViewer"
                      Grid.Row="3"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 列ヘッダー -->
                    <RowDefinition Height="*"/>
                    <!-- アイテムリスト -->
                </Grid.RowDefinitions>

                <!-- ===== 列ヘッダー ===== -->
                <Border Grid.Row="0" Background="#18808080" Padding="4,4" Margin="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <!-- 切替・削除ボタン -->
                            <ColumnDefinition Width="150" MinWidth="100"/>
                            <!-- プラグイン名 -->
                            <ColumnDefinition Width="90"/>
                            <!-- 作者 -->
                            <ColumnDefinition Width="70"/>
                            <!-- バージョン -->
                            <ColumnDefinition Width="80"/>
                            <!-- タイプ -->
                            <ColumnDefinition Width="55"/>
                            <!-- 状態 -->
                            <ColumnDefinition Width="116"/>
                            <!-- 公開日 -->
                            <ColumnDefinition Width="116"/>
                            <!-- DL日時 -->
                            <ColumnDefinition Width="38"/>
                            <!-- フォルダ -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text=""           FontSize="11" Opacity="0.65" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="プラグイン名" FontSize="11" Opacity="0.65" Margin="4,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="作者"        FontSize="11" Opacity="0.65"/>
                        <TextBlock Grid.Column="3" Text="バージョン"  FontSize="11" Opacity="0.65"/>
                        <TextBlock Grid.Column="4" Text="タイプ"      FontSize="11" Opacity="0.65"/>
                        <TextBlock Grid.Column="5" Text="状態"        FontSize="11" Opacity="0.65"/>
                        <TextBlock Grid.Column="6" Text="公開日"      FontSize="11" Opacity="0.65"/>
                        <TextBlock Grid.Column="7" Text="DL日時"      FontSize="11" Opacity="0.65"/>
                        <TextBlock Grid.Column="8" Text="📁"          FontSize="11" Opacity="0.65" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ===== アイテムリスト ===== -->
                <!--
                    ListBox 自身の ScrollViewer を無効化して
                    外側の ScrollViewer に横スクロールを委ねる。
                    縦スクロールは別途 ScrollViewer を縦方向に有効にすることで対応。
                -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="PluginListBox"
                             ItemsSource="{Binding PluginsView}"
                             SelectionMode="Extended"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="1" BorderBrush="#80808080"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Loaded="PluginListBox_Loaded"
                             PreviewMouseWheel="PluginListBox_PreviewMouseWheel">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="4,3"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="true">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2000AEEF"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4000AEEF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#4000AEEF"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#8000AEEF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="150" MinWidth="100"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="116"/>
                                        <ColumnDefinition Width="116"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: 切替・削除ボタン -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- 有効/無効切り替え -->
                                        <ToggleButton IsChecked="{Binding IsTogglePending, Mode=TwoWay}"
                                                      ToolTip="有効/無効 切り替え" Margin="0,0,4,0"
                                                      Tag="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M15,13H9V11H15V13Z"
                                                      Template="{StaticResource IconToggleTemplate}"/>
                                        <!-- 削除 -->
                                        <ToggleButton IsChecked="{Binding IsPendingDelete, Mode=TwoWay}"
                                                      ToolTip="削除"
                                                      Tag="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                      Template="{StaticResource DeleteToggleTemplate}"/>
                                    </StackPanel>

                                    <!-- Col 1: プラグイン名 -->
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,6,0"
                                               ToolTip="{Binding DisplayName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPendingDelete}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Col 2: 作者 -->
                                    <TextBlock Grid.Column="2" Text="{Binding InfoAuthor}"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Opacity="0.8"
                                               ToolTip="{Binding InfoAuthor}"/>

                                    <!-- Col 3: バージョン -->
                                    <TextBlock Grid.Column="3" Text="{Binding InfoVersion}"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Opacity="0.8"/>

                                    <!-- Col 4: タイプ (バッジ) -->
                                    <Border Grid.Column="4" CornerRadius="3" Padding="5,1"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2800AEEF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasInfoJson}" Value="False">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding InfoType}" FontSize="10" Foreground="#00AEEF"/>
                                    </Border>

                                    <!-- Col 5: 状態バッジ -->
                                    <Border Grid.Column="5" CornerRadius="3" Padding="4,1"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2800C060"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                        <Setter Property="Background" Value="#28808080"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTogglePending}" Value="True">
                                                        <Setter Property="Background" Value="#2800AEEF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="有効"/>
                                                    <Setter Property="Foreground" Value="#00C060"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="Text" Value="無効"/>
                                                            <Setter Property="Foreground" Value="#A0A0A0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTogglePending}" Value="True">
                                                            <Setter Property="Text" Value="変更予定"/>
                                                            <Setter Property="Foreground" Value="#00AEEF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Col 6: 公開日 -->
                                    <TextBlock Grid.Column="6" Text="{Binding InfoPublishedAt}"
                                               FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>

                                    <!-- Col 7: DL日時 -->
                                    <TextBlock Grid.Column="7" Text="{Binding InfoDownloadedAt}"
                                               FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>

                                    <!-- Col 8: フォルダを開く -->
                                    <Button Grid.Column="8"
                                            Command="{Binding OpenFolderCommand}"
                                            ToolTip="このプラグインのフォルダを開く"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Padding="2" Background="Transparent" BorderThickness="0">
                                        <Path Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              Stretch="Uniform" Width="15" Height="15" Opacity="0.5">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.9"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>

        <!-- ===== 変更を適用 ===== -->
        <Button Grid.Row="4" Content="変更を適用" Command="{Binding ExecuteCommand}"
                Height="38" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
